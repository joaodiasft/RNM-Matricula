# copythis file to .env.local and fill in values

# Neon Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Banco do RNM-Chamada (presença / chamada) — Neon separado
CHAMADA_DATABASE_URL=postgresql://user:pass@ep-chamada.neon.tech/neondb?sslmode=require

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria-min-32-chars

# Admin seed (usado em npm run db:seed)
ADMIN_EMAIL=naredacaonota1000@gmail.com
ADMIN_PASSWORD=TroqueEstaSenhaForte123!

# ─────────────────────────────────────────────────────────────────────────────
# E-MAIL — configure UM provedor. Diagnostique com: npm run email:doctor
# Prioridade no app: webhook > Brevo > Resend.
# ─────────────────────────────────────────────────────────────────────────────
#
# CAMINHO A — Brevo (RECOMENDADO; grátis, SEM domínio, funciona no Cloudflare)
#   1. brevo.com → Senders → Add a sender: naredacaonota1000@gmail.com → confirme por link
#   2. brevo.com → SMTP & API → API Keys → gere uma chave
#   3. node scripts/resend-doctor.mjs --send
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER=naredacaonota1000@gmail.com
BREVO_SENDER_NAME=Redação Nota Mil
RESEND_REPLY_TO=naredacaonota1000@gmail.com
COMPANY_EMAIL=naredacaonota1000@gmail.com

# CAMINHO B — Resend (profissional; exige DOMÍNIO VERIFICADO)
#   resend.com → Domains → Add Domain → registros no Cloudflare DNS → Verify
#   Sem domínio verificado, o Resend só entrega ao e-mail dono da conta (sandbox).
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Redação Nota Mil <matricula@redacaonotamil.com.br>

# CAMINHO C — Webhook Gmail (grátis, sem domínio; ver scripts/gmail-mail-webhook.gs)
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# EMAIL_WEBHOOK_SECRET=uma-senha-longa-igual-a-do-Apps-Script

# Cloudflare Turnstile (deixe vazio em dev para pular verificação)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron protection
CRON_SECRET=troque-por-secret-dos-crons

# Taxa padrão maquininha (%)
DEFAULT_CARD_FEE_PERCENT=3.5
